rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vai trò suy ra từ phần trước @ của email đăng nhập (kiosk* / thuthu* / còn lại = sinh viên = MSSV)
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function who()      { return request.auth.token.email.split('@')[0]; }
    function isLib()    { return signedIn() && who().matches('.*thuthu.*'); }
    function isStaff()  { return signedIn() && (who().matches('.*thuthu.*') || who().matches('.*kiosk.*')); }
    // MSSV của người đăng nhập (tài khoản test sinhvien.vipham ánh xạ về 251121599999)
    function sid()      { return who() == 'sinhvien.vipham' ? '251121599999' : who(); }
    function isMine()   { return signedIn() && resource.data.mssv == sid(); }
    function newIsMine(){ return signedIn() && request.resource.data.mssv == sid(); }

    match /books/{id} {
      allow read: if signedIn();
      allow create, delete: if isLib();
      // Sinh viên chỉ được đổi đúng trường tồn kho khi đặt mượn
      allow update: if isLib() || (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['so_luong_con']));
    }
    match /lockers/{id}    { allow read, write: if signedIn(); }
    match /orders/{id}     { allow read: if isStaff() || isMine(); allow create: if newIsMine(); allow update: if isStaff(); }
    match /borrowings/{id} {
      allow read: if isStaff() || isMine();
      allow create: if isStaff();
      // Sinh viên chỉ được GIA HẠN: đổi đúng các trường hạn trả của cuốn đang mượn của chính mình
      allow update: if isStaff() || (isMine() && resource.data.trang_thai == 'dang_muon'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['han_tra', 'so_lan_gia_han', 'ngay_gia_han']));
    }
    match /returns/{id} {
      allow read: if isStaff() || isMine();
      // Không cho client tự tạo trạng thái paid; chỉ Firebase Admin từ backend được ghi.
      allow create: if newIsMine() && !request.resource.data.keys().hasAny(['payment_status', 'paid_amount', 'payment_txn_id']);
      // Các thuộc tính ngân hàng do backend xác minh, không sửa bằng client.
      function noClientPaymentApproval() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paid_amount', 'paid_at', 'payment_txn_id'
        ]) && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['payment_status'])
          && request.resource.data.payment_status == 'paid');
      }
      allow update: if noClientPaymentApproval() && (
        isStaff() || (isMine() && resource.data.trang_thai in ['cho_bo_sach', 'cho_tra_tai_kiosk']
          && request.resource.data.trang_thai == 'da_huy'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trang_thai', 'thoi_gian_huy']))
      );
    }
    match /penalties/{id} {
      allow read: if isLib() || isMine();
      allow create: if isLib() && request.resource.data.payment_status == 'pending'
        && request.resource.data.payment_code is string
        && request.resource.data.payment_code.matches('DUEF[A-Z0-9]{20}')
        && request.resource.data.so_tien_phat > 0;
      // Chỉ Firebase Admin từ API SePay được xác nhận paid.
      allow update: if isLib() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'payment_status', 'paid_amount', 'payment_txn_id', 'paid_at',
        'payment_amount', 'payment_code', 'so_tien_phat', 'mssv', 'return_id'
      ]);
      allow delete: if false;
    }
  }
}
